<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="box1">
    <static>false</static> <!-- true = unbeweglich, false = kann fallen -->
    <link name="link">
      <inertial>
        <mass>0.03</mass>
        <inertia>
           <ixx>1.125e-05</ixx>
           <iyy>1.125e-05</iyy>
           <izz>4.5e-06</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.06 0.03 0.03</size> <!-- Breite, Tiefe, Höhe in Metern -->
          </box>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient> <!-- Grün -->
          <diffuse>0 1 0 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.06 0.03 0.03</size>
          </box>
        </geometry>
         <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
